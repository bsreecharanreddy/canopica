{
  "includeCoAuthoredBy": false,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-status-md-commit.sh\"",
            "timeout": 15,
            "statusMessage": "Checking docs/STATUS.md is staged with this commit..."
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "terraform@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true
  }
}
