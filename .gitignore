# Java
target/
*.class

# Node
node_modules/
dist/
*.tsbuildinfo

# Python
.venv/
__pycache__/
*.py[cod]
.mypy_cache/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# Coverage reports (Java's land under the already-ignored target/)
ui/coverage/

# Data platform output — generated, never committed
data-platform/warehouse/
*.duckdb
*.duckdb.wal

# dbt
target/
dbt_packages/
logs/
.user.yml

# Local environment
.env
!infra/.env.example

# deepeval writes a telemetry/cache dir into whatever cwd it's imported
# from -- ai/ is the intended one, but a stray cwd (repo root,
# data-platform/) can pick one up too.
.deepeval/

# Ollama model blobs — bind-mounted (not a named volume) so CI can cache
# this path with actions/cache; several GB, never committed
infra/ollama-models/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
# Lock file *is* committed (pins provider versions) — this only ignores
# the actual per-run state/plan artifacts above.

# OS
.DS_Store

# Playwright MCP session artifacts (screenshots, page snapshots, console
# logs) -- written to repo root by the browser tool during manual
# verification checks, never meant to be committed.
.playwright-mcp/
