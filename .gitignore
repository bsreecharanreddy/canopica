# Data platform output — generated, never committed
data-platform/warehouse/
*.duckdb
*.duckdb.wal

# dbt
target/
dbt_packages/
logs/
.user.yml

# Local environment
.env
!infra/.env.example

# Ollama model blobs — bind-mounted (not a named volume) so CI can cache
# this path with actions/cache; several GB, never committed
infra/ollama-models/

# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
# Lock file *is* committed (pins provider versions) — this only ignores
# the actual per-run state/plan artifacts above.

# OS
.DS_Store
