<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>canopica</groupId>
  <artifactId>canopica-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Canopica</name>
  <description>Canopica — a deterministic, auditable decision system with an AI capability layer built on top</description>

  <modules>
    <module>rules-engine</module>
    <module>api</module>
  </modules>

  <properties>
    <java.version>17</java.version>
    <maven.compiler.release>17</maven.compiler.release>
    <!-- Spring MVC needs this to bind @PathVariable/@RequestParam by parameter name without an
         explicit name on every annotation (e.g. @PathVariable UUID id, not @PathVariable("id") UUID id). -->
    <maven.compiler.parameters>true</maven.compiler.parameters>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring.boot.version>3.5.3</spring.boot.version>
    <kie.version>10.2.0</kie.version>
    <testcontainers.version>2.0.5</testcontainers.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring.boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.5.6</version>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <!-- Cyclomatic-complexity gate (docs/STATUS.md, 2026-08-27 decision:
           "yes, before Phase 4 wrap", folded in 2026-08-31 during the
           public-repo-readiness pass, once Phase 4 had already wrapped
           without it). Bound to verify, which ./mvnw -B verify (make
           test, CI's java job) already runs, so no separate lint step or
           CI change is needed. ${maven.multiModuleProjectDirectory} (a
           Maven-3.3.1+ builtin) resolves to this root regardless of which
           module (api, rules-engine) is actually building. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <version>3.28.0</version>
        <configuration>
          <rulesets>
            <ruleset>${maven.multiModuleProjectDirectory}/pmd-ruleset.xml</ruleset>
          </rulesets>
          <printFailingErrors>true</printFailingErrors>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
