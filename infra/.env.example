# Copy to infra/.env for local overrides. Every value here already matches
# the Settings defaults in data-platform/src/ies_data/config.py, so a fresh
# clone runs without this file existing at all -- it exists to document what
# can be overridden and how, not because anything requires it.

IES_OPERATIONAL_DSN=postgresql://ies_app:ies_app@localhost:5432/ies_operational
IES_SERVING_DSN=postgresql://ies_app:ies_app@localhost:5432/ies_serving

IES_METABASE_URL=http://localhost:3001
IES_METABASE_USER=admin@ies.local
IES_METABASE_PASSWORD=IesAdmin123!
