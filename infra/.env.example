# Copy to infra/.env for local overrides. Every value here already matches
# the Settings defaults in data-platform/src/canopica_data/config.py, so a fresh
# clone runs without this file existing at all -- it exists to document what
# can be overridden and how, not because anything requires it.

CANOPICA_OPERATIONAL_DSN=postgresql://canopica_app:canopica_app@localhost:5432/canopica_operational
CANOPICA_SERVING_DSN=postgresql://canopica_app:canopica_app@localhost:5432/canopica_serving

CANOPICA_METABASE_URL=http://localhost:3001
CANOPICA_METABASE_USER=admin@canopica.local
CANOPICA_METABASE_PASSWORD=CanopicaAdmin123!
